// Two CopperLists per cycle on three worker threads. `right` is stateless, so
// its two occurrences run on different workers with no order between them;
// every stateful task is ordered across the two CopperLists and the cycle
// boundary by explicit edges.
(
    runtime: (
        thread_pools: [
            (id: "bg", threads: 1),
        ],
        planner: (
            type: "cu29::planner::Fixed",
            config: {
                "plan": {
                    "version": 2,
                    "missions": {
                        "default": {
                            "copperlists_per_cycle": 2,
                            "max_in_flight": 4,
                            "steps": [
                                {
                                    "key": "mission:default|task:src|phase:whole",
                                    "copperlist": 0,
                                },
                                {
                                    "key": "mission:default|task:left|phase:whole",
                                    "copperlist": 0,
                                },
                                {
                                    "key": "mission:default|task:right|phase:whole",
                                    "copperlist": 0,
