                                        "kind": "thread",
                                    },
                                    "steps": [
                                        9,
                                        10,
                                        11,
                                        12,
                                        13,
                                    ],
                                },
                            ],
                            "background": [
                                {
                                    "task": "bg",
                                    "pool": "bg",
                                    "max_running": 1,
                                    "result": {
                                        "kind": "lag",
                                        "lag": 1,
