                        },
                    },
                },
            },
        ),
    ),
    tasks: [
        (id: "src", type: "Source"),
        (
            id: "left",
            type: "RunningSum",
        ),
        (
            id: "right",
            type: "Triple",
            kind: stateless_task,
        ),
        (id: "join", type: "Join"),
        (
            id: "sink",
            type: "Sink",
            config: {
                "app": "lane",
                "stop_after": 200,
