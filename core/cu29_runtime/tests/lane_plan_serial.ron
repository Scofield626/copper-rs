(
    runtime: (
        thread_pools: [
            (id: "bg", threads: 1),
        ],
        planner: (
            type: "cu29::planner::Fixed",
            config: {
                "plan": {
                    "version": 2,
                    "missions": {
                        "default": {
                            "copperlists_per_cycle": 1,
                            "max_in_flight": 1,
                            "steps": [
                                {
                                    "key": "mission:default|task:src|phase:whole",
                                    "copperlist": 0,
                                },
                                {
                                    "key": "mission:default|task:left|phase:whole",
                                    "copperlist": 0,
                                },
                                {
                                    "key": "mission:default|task:right|phase:whole",
                                    "copperlist": 0,
                                },
                                {
                                    "key": "mission:default|task:join|phase:whole",
                                    "copperlist": 0,
                                },
                                {
                                    "key": "mission:default|task:sink|phase:whole",
                                    "copperlist": 0,
                                },
                                {
                                    "key": "mission:default|task:bg|phase:whole",
                                    "copperlist": 0,
                                },
                                {
                                    "key": "mission:default|task:sink2|phase:whole",
                                    "copperlist": 0,
                                },
                            ],
                            "workers": [
                                {
                                    "id": "main",
                                    "placement": {
                                        "kind": "main",
                                    },
                                    "steps": [
                                        0,
                                        1,
                                        2,
                                        3,
                                        4,
                                        5,
                                        6,
                                    ],
                                },
                            ],
                            "background": [
                                {
                                    "task": "bg",
                                    "pool": "bg",
                                    "max_running": 1,
                                    "result": {
                                        "kind": "lag",
                                        "lag": 1,
                                    },
                                },
                            ],
                            "dependencies": [],
                        },
                    },
                },
            },
        ),
    ),
    tasks: [
        (id: "src", type: "Source"),
        (
            id: "left",
            type: "RunningSum",
        ),
        (
            id: "right",
            type: "Triple",
            kind: stateless_task,
        ),
        (id: "join", type: "Join"),
        (
            id: "sink",
            type: "Sink",
            config: {
                "app": "serial",
                "stop_after": 200,
            },
        ),
        (
            id: "bg",
            type: "Offset",
            background: (pool: "bg"),
        ),
        (id: "sink2", type: "Sink2"),
    ],
    cnx: [
        (
            src: "src",
            dst: "left",
            msg: "u64",
        ),
        (
            src: "src",
            dst: "right",
            msg: "u64",
        ),
        (
            src: "left",
            dst: "join",
            msg: "u64",
        ),
        (
            src: "right",
            dst: "join",
            msg: "u64",
        ),
        (
            src: "join",
            dst: "sink",
            msg: "u64",
        ),
        (
            src: "src",
            dst: "bg",
            msg: "u64",
        ),
        (
            src: "bg",
            dst: "sink2",
            msg: "u64",
        ),
    ],
    logging: (
        slab_size_mib: 16,
        keyframe_interval: 7,
    ),
)